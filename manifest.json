{
  "manifest_version": 3,
  "name": "AEGIS Invites for Facebook",
  "version": "1.1.7",
  "description": "Invite people who reacted to your Facebook Page posts. A project of The AEGIS Alliance.",
  "author": "Gambit Mutant",
  "homepage_url": "https://github.com/GambitMutant/aegis-invites-for-facebook",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "AEGIS Invites for Facebook"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.facebook.com/*", "https://business.facebook.com/*", "https://*.facebook.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": ["storage", "activeTab", "scripting", "alarms", "tabs"],
  "host_permissions": ["https://*.facebook.com/*"],
  "web_accessible_resources": [
    {
      "resources": ["icons/*", "content.css"],
      "matches": ["https://*.facebook.com/*"]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "aegis-invites@gambitmutant.github.io",
      "strict_min_version": "121.0"
    }
  }
}
